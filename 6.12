import SwiftUI

struct ContentView: View {
    var body: some View {
        ZStack {
            //背景画像を指定する
            Image(.background)
            //リサイズする
                .resizeble()
            //画面いっぱいになるようにセーフエリア外まで表示されるように指定
.ignoreSafeArea()
            //アスペクト比(縦横比）を維持して短辺基準に収まるようにする
                .scaledToFill()
            
            //水平にレイアウト（横方向にレイアウト）
            HStack {
                //シンバルボタン
                Button {
                    //ボタンをタップしたときのアクション
                } label: {
                    //画像を表示する
                    Image(.cymbal)
                }//シンバルボタンはここまで
                
                //ギターボタン
                Button {
                    //ボタンをタップしたときのアクション
                } label: {
                    //画像を表示する
                    Image(.guitar)
                }//ギターボタンはここまで
            }//HStackここまで
        }//ZStackここまで
    }
 }

#Preview {
    ContentView()
    
}
