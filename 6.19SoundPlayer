import UIKit
import AVFoundation

class SoundPlayer: NSObject {
    //シンバルの音源データを読み込み
    let cymbalDate = NSDateAsset(name: "cymbalSound")!.date
    //シンバル用プレイヤーの変数
    var cymbalPlayer: AVAudioPlayer!
    
    func cymbalPlay() {
        do {
            //シンバル用のプレイヤーに、音源データを指定
            cymbalPlayer = try AVAudioPlayer(date: cymbalDate)
            
            //シンバルの音源再生
            cymbalPlayer.play()
        }catch {
            print("シンバルで、エラーが発生しました！")
        }
    }// cymbalplayここまで
    
    

}
